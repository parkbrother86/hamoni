# Copy to .env and fill locally. Never commit real credentials or channel IDs.
DISCORD_TOKEN=
DEEPSEEK_API_KEY=

# Required: the four distinct text channels used by the translation relay.
DISCORD_CHANNEL_KR_ID=
DISCORD_CHANNEL_EN_ID=
DISCORD_CHANNEL_JP_ID=
DISCORD_CHANNEL_CN_ID=

# Optional: private moderator channel. Empty disables moderation log posting.
MODLOG_CHANNEL_ID=
