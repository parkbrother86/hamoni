# Dependencies
node_modules/

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.*.local

# Runtime data
data/
*.log
logs/

# Editor / OS / AI tools
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/

# pm2
.pm2/
ecosystem.config.local.js

# Project-local
*.local.json

# Markdown — only README.md is tracked.
# Exception: mtbench/ is the self-hosted-serving handoff for the GPU box, so
# its docs must travel with the repo. Everything under bench/ stays local.
*.md
!README.md
!mtbench/*.md

# Python
__pycache__/
*.pyc

# mtbench — 로컬 모델 가중치 / venv (커밋 금지, HF 에서 재다운로드)
mtbench/models/
mtbench/venv/
*.gguf
